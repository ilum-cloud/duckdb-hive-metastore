# name: test/sql/hive/partition_file_missing_column.test
# description: A column some partition files lack reads as NULL for their rows, as for files written before ALTER TABLE ADD COLUMNS
# group: [hive]

# Requires test/sql/hive/post_seed_nonstandard_partitions.sh (the test-fixture-nonstd-partitions Makefile target).
# In duck_fixture_schema_mix the first file under the table location (a_dir) belongs to the last partition (batch c),
# so the file the table's columns are read from is not the first file of the first partition.

require hive_metastore

require-env HMS_TEST_AVAILABLE

require httpfs

require parquet

statement ok
CREATE OR REPLACE SECRET s3 (TYPE S3, PROVIDER config, KEY_ID 'minioadmin', SECRET 'minioadmin', ENDPOINT 'localhost:9000', REGION 'us-east-1', URL_STYLE 'path', USE_SSL false);

# Written after the column was added. The table's columns come from this file.
statement ok
COPY (SELECT 3 AS id, 300 AS amount, 'new' AS note) TO 's3://test-bucket/duck_fixture_schema_mix/a_dir/data.parquet';

# Written before
statement ok
COPY (SELECT 1 AS id, 100 AS amount) TO 's3://test-bucket/duck_fixture_schema_mix/z_dir/data.parquet';

statement ok
COPY (SELECT 2 AS id, 200 AS amount) TO 's3://test-bucket/duck_fixture_schema_mix/y_dir/data.parquet';

statement ok
ATTACH 'thrift://localhost:9083' AS hms (TYPE hive_metastore);

query TT
SELECT name, type FROM pragma_table_info('hms.sample_db.duck_fixture_schema_mix') ORDER BY cid;
----
id	INTEGER
amount	INTEGER
note	VARCHAR
batch	VARCHAR

query IITT
SELECT id, amount, note, batch FROM hms.sample_db.duck_fixture_schema_mix ORDER BY id;
----
1	100	NULL	a
2	200	NULL	b
3	300	new	c

query I
SELECT id FROM hms.sample_db.duck_fixture_schema_mix WHERE note = 'new';
----
3

query I
SELECT count(*) FROM hms.sample_db.duck_fixture_schema_mix WHERE note IS NULL;
----
2

query T
SELECT string_agg(batch, ',' ORDER BY batch) FROM hms.sample_db.duck_fixture_schema_mix;
----
a,b,c
