# name: test/sql/hive/partition_outside_table_root.test
# description: A partition stored outside the table location is read, because the scan follows the location the metastore records
# group: [hive]

# Requires test/sql/hive/post_seed_nonstandard_partitions.sh (the test-fixture-nonstd-partitions Makefile target).

require hive_metastore

require-env HMS_TEST_AVAILABLE

require httpfs

require parquet

statement ok
CREATE OR REPLACE SECRET s3 (TYPE S3, PROVIDER config, KEY_ID 'minioadmin', SECRET 'minioadmin', ENDPOINT 'localhost:9000', REGION 'us-east-1', URL_STYLE 'path', USE_SSL false);

statement ok
COPY (SELECT * FROM (VALUES (1, 10), (2, 20)) t(review_id, product_id)) TO 's3://test-bucket/duck_fixture_nonstd/production/2024/data.parquet';

statement ok
COPY (SELECT * FROM (VALUES (3, 30)) t(review_id, product_id)) TO 's3://test-bucket/duck_fixture_nonstd/production/2025/data.parquet';

statement ok
COPY (SELECT * FROM (VALUES (4, 40), (5, 50)) t(review_id, product_id)) TO 's3://test-bucket/duck_fixture_outside/staging_2024/data.parquet';

statement ok
COPY (SELECT * FROM (VALUES (6, 60)) t(review_id, product_id)) TO 's3://test-bucket/duck_fixture_nonstd/unknown/2025/data.parquet';

# Hive names its own data files after the task that wrote them, without an extension
statement ok
COPY (SELECT * FROM (VALUES (7, 70)) t(review_id, product_id)) TO 's3://test-bucket/duck_fixture_nonstd/hivefile/2026/000000_0' (FORMAT parquet);

statement ok
ATTACH 'thrift://localhost:9083' AS hms (TYPE hive_metastore);

# The 'staging' partition lives under duck_fixture_outside/, so globbing the table location alone misses it
query I
SELECT count(*) FROM read_parquet('s3://test-bucket/duck_fixture_nonstd/**/*.parquet');
----
4

query I
SELECT count(*) FROM hms.sample_db.duck_fixture_nonstd;
----
7

query IIT
SELECT review_id, product_id, region FROM hms.sample_db.duck_fixture_nonstd WHERE region = 'staging' ORDER BY review_id;
----
4	40	staging
5	50	staging
