# name: test/sql/hive/partition_path_pruning.test
# description: In path mode, and when a table has no partition registered, a filter on a partition column skips the files whose key=value directories rule them out
# group: [hive]

# Requires test/sql/hive/post_seed_nonstandard_partitions.sh (the test-fixture-nonstd-partitions Makefile target).

require hive_metastore

require-env HMS_TEST_AVAILABLE

require httpfs

require parquet

statement ok
CREATE OR REPLACE SECRET s3 (TYPE S3, PROVIDER config, KEY_ID 'minioadmin', SECRET 'minioadmin', ENDPOINT 'localhost:9000', REGION 'us-east-1', URL_STYLE 'path', USE_SSL false);

# sample_db.reviews uses key=value directories (rating=1 ... rating=5)
statement ok
ATTACH 'thrift://localhost:9083' AS hms_path (TYPE hive_metastore, PARTITION_MODE 'path', METADATA_CACHE_TTL 3600);

# Resolve the table first, so only the scan below is counted
statement ok
DESCRIBE hms_path.sample_db.reviews;

statement ok
CALL enable_logging(level='debug', storage='memory');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM hms_path.sample_db.reviews WHERE rating = 5;
----
30

# Only files under rating=5 were opened
query II
SELECT count(*) FILTER (WHERE url_decode(request.url) NOT LIKE '%rating=5%'),
       count(*) FILTER (WHERE url_decode(request.url) LIKE '%rating=5%') > 0
FROM duckdb_logs_parsed('HTTP') WHERE request.type = 'GET' AND url_decode(request.url) NOT LIKE '%list-type%';
----
0	true

statement ok
CALL disable_logging();

# duck_fixture_values_in_files has no partition registered: some files carry region in their path, others in their
# data. A file whose path says nothing about region must not be skipped, its rows may match.
statement ok
COPY (SELECT * FROM (VALUES (1, 'eu'), (2, 'us')) t(id, region)) TO 's3://test-bucket/duck_fixture_values_in_files/batch_2024_09_15/data.parquet';

statement ok
COPY (SELECT 3 AS id) TO 's3://test-bucket/duck_fixture_values_in_files/batch_2024_09_16/data.parquet';

statement ok
COPY (SELECT 4 AS id, 'zz' AS region) TO 's3://test-bucket/duck_fixture_values_in_files/region=apac/data.parquet';

statement ok
COPY (SELECT 5 AS id) TO 's3://test-bucket/duck_fixture_values_in_files/region=emea/data.parquet';

statement ok
ATTACH 'thrift://localhost:9083' AS hms (TYPE hive_metastore, METADATA_CACHE_TTL 3600);

statement ok
DESCRIBE hms.sample_db.duck_fixture_values_in_files;

query I
SELECT id FROM hms.sample_db.duck_fixture_values_in_files WHERE region = 'eu';
----
1

statement ok
CALL enable_logging(level='debug', storage='memory');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT id FROM hms.sample_db.duck_fixture_values_in_files WHERE region = 'apac';
----
4

# The region=emea file is ruled out by its path and never opened
query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.type = 'GET' AND url_decode(request.url) LIKE '%region=emea%';
----
0

statement ok
CALL disable_logging();
