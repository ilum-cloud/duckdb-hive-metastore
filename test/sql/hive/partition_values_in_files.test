# name: test/sql/hive/partition_values_in_files.test
# description: A partitioned table with no partition registered reads a partition column from the files when the directory names do not carry it, and warns once
# group: [hive]

# Requires test/sql/hive/post_seed_nonstandard_partitions.sh (the test-fixture-nonstd-partitions Makefile target).
# duck_fixture_values_in_files declares the partition column region but has no partition registered, so the scan
# falls back to the files under the table location.

require hive_metastore

require-env HMS_TEST_AVAILABLE

require httpfs

require parquet

statement ok
CREATE OR REPLACE SECRET s3 (TYPE S3, PROVIDER config, KEY_ID 'minioadmin', SECRET 'minioadmin', ENDPOINT 'localhost:9000', REGION 'us-east-1', URL_STYLE 'path', USE_SSL false);

# The files hold the partition values themselves
statement ok
COPY (SELECT * FROM (VALUES (1, 'eu'), (2, 'us')) t(id, region)) TO 's3://test-bucket/duck_fixture_values_in_files/batch_2024_09_15/data.parquet';

# A file without the column: NULL
statement ok
COPY (SELECT 3 AS id) TO 's3://test-bucket/duck_fixture_values_in_files/batch_2024_09_16/data.parquet';

# A key=value directory still gives the value, as in Hive
statement ok
COPY (SELECT 4 AS id, 'zz' AS region) TO 's3://test-bucket/duck_fixture_values_in_files/region=apac/data.parquet';

statement ok
COPY (SELECT 5 AS id) TO 's3://test-bucket/duck_fixture_values_in_files/region=emea/data.parquet';

statement ok
ATTACH 'thrift://localhost:9083' AS hms (TYPE hive_metastore);

statement ok
CALL enable_logging(level='warning', storage='memory');

query IT
SELECT id, region FROM hms.sample_db.duck_fixture_values_in_files ORDER BY id;
----
1	eu
2	us
3	NULL
4	apac
5	emea

query I
SELECT id FROM hms.sample_db.duck_fixture_values_in_files WHERE region = 'us';
----
2

# Falling back is worth knowing about, once
query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%duck\_fixture\_values\_in\_files%no partition registered%' ESCAPE '\';
----
1

statement ok
CALL disable_logging();
