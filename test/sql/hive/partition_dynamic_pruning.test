# name: test/sql/hive/partition_dynamic_pruning.test
# description: The keys a join pushes into a partitioned scan select its partitions when the scan starts: only those are fetched, listed and read
# group: [hive]

# Requires test/sql/hive/post_seed_nonstandard_partitions.sh (the test-fixture-nonstd-partitions Makefile target).
# duck_fixture_pushdown (7 partitions, keys s STRING, n INT, d DATE; p<id> holds row id) is smaller than the sample
# planning takes, so its partitions are all known and the join keys prune them without a request.
# duck_fixture_many_parts (300 partitions, n = 1 to 300, at p<n>) is not: the metastore selects the partitions.

require hive_metastore

require-env HMS_TEST_AVAILABLE

require httpfs

require parquet

statement ok
CREATE OR REPLACE SECRET s3 (TYPE S3, PROVIDER config, KEY_ID 'minioadmin', SECRET 'minioadmin', ENDPOINT 'localhost:9000', REGION 'us-east-1', URL_STYLE 'path', USE_SSL false);

loop i 1 8

statement ok
COPY (SELECT ${i} AS id) TO 's3://test-bucket/duck_fixture_pushdown/p${i}/data.parquet';

endloop

statement ok
COPY (SELECT 1 AS id) TO 's3://test-bucket/duck_fixture_many_parts/p1/data.parquet';

loop i 0 4

statement ok
COPY (SELECT (1000 + ${i} * 25 + range)::INT AS id FROM range(25)) TO 's3://test-bucket/duck_fixture_many_parts/p1/extra_${i}.parquet';

endloop

statement ok
COPY (SELECT 100 AS id) TO 's3://test-bucket/duck_fixture_many_parts/p100/data.parquet';

statement ok
COPY (SELECT 250 AS id) TO 's3://test-bucket/duck_fixture_many_parts/p250/data.parquet';

statement ok
ATTACH 'thrift://localhost:9083' AS hms (TYPE hive_metastore, METADATA_CACHE_TTL 3600);

statement ok
ATTACH 'thrift://localhost:9083' AS hms_static (TYPE hive_metastore, METADATA_CACHE_TTL 3600, DYNAMIC_PARTITION_PRUNING false);

statement error
ATTACH 'thrift://localhost:9083' AS hms_bad (TYPE hive_metastore, DYNAMIC_PARTITION_PRUNING 'sometimes');
----
DYNAMIC_PARTITION_PRUNING must be true or false, got: sometimes

statement ok
CREATE TEMP TABLE int_keys AS SELECT * FROM (VALUES (2), (6)) t(k);

statement ok
CREATE TEMP TABLE many_keys AS SELECT * FROM (VALUES (100), (250)) t(k);

# Resolve the tables first, so only the scans below are counted
statement ok
DESCRIBE hms.sample_db.duck_fixture_pushdown;

statement ok
DESCRIBE hms.sample_db.duck_fixture_many_parts;

statement ok
CALL enable_logging(level='debug', storage='memory');

# A join: only the partitions of the two keys are listed and read
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(p.id ORDER BY p.id) FROM hms.sample_db.duck_fixture_pushdown p JOIN int_keys ON p.n = int_keys.k;
----
[2, 6]

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'hive_metastore partitions % table=duck_fixture_pushdown method=cached_plan selected=2 % dynamic=1';
----
1

query II
SELECT count(*) FILTER (WHERE regexp_matches(url_decode(request.url), 'duck_fixture_pushdown/p[26]/')),
       count(*) FILTER (WHERE NOT regexp_matches(url_decode(request.url), 'duck_fixture_pushdown/p[26]/'))
FROM duckdb_logs_parsed('HTTP');
----
4	0

# The metastore selects them when it holds more partitions than planning looked at
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(m.id ORDER BY m.id) FROM hms.sample_db.duck_fixture_many_parts m JOIN many_keys ON m.n = many_keys.k;
----
[100, 250]

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'hive_metastore partitions % table=duck_fixture_many_parts method=% selected=2 % dynamic=1';
----
1

query II
SELECT count(*) FILTER (WHERE regexp_matches(url_decode(request.url), 'duck_fixture_many_parts/p(100|250)/')),
       count(*) FILTER (WHERE NOT regexp_matches(url_decode(request.url), 'duck_fixture_many_parts/p(100|250)/'))
FROM duckdb_logs_parsed('HTTP');
----
4	0

# A semi-join pushes the keys the same way. A correlated EXISTS does not: DuckDB joins on IS NOT DISTINCT FROM there,
# which it pushes no join filter for, so every partition is read (the rows are the same).
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id ORDER BY id) FROM hms.sample_db.duck_fixture_pushdown WHERE n IN (SELECT k FROM int_keys);
----
[2, 6]

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'hive_metastore partitions % table=duck_fixture_pushdown % selected=2 % dynamic=1';
----
1

query I
SELECT list(p.id ORDER BY p.id) FROM hms.sample_db.duck_fixture_pushdown p WHERE EXISTS (SELECT 1 FROM int_keys WHERE int_keys.k = p.n);
----
[2, 6]

# String and date keys
query I
SELECT list(p.id ORDER BY p.id) FROM hms.sample_db.duck_fixture_pushdown p JOIN (VALUES ('a'), ('c'), ('x/y')) t(k) ON p.s = t.k;
----
[1, 5, 7]

query I
SELECT list(p.id ORDER BY p.id) FROM hms.sample_db.duck_fixture_pushdown p JOIN (VALUES (DATE '2024-01-02'), (DATE '2024-01-07')) t(k) ON p.d = t.k;
----
[2, 7]

# More keys than DuckDB lists (dynamic_or_filter_threshold, 50 by default): the range between the smallest and the
# largest key selects the partitions
statement ok
CREATE TEMP TABLE odd_keys AS SELECT (2 * range + 1)::INT AS k FROM range(60);

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(m.id ORDER BY m.id) FROM hms.sample_db.duck_fixture_many_parts m JOIN odd_keys ON m.n = odd_keys.k WHERE m.id < 1000;
----
[1]

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'hive_metastore partitions % table=duck_fixture_many_parts % selected=60 % dynamic=1';
----
0

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'hive_metastore partitions % table=duck_fixture_many_parts % selected=119 % dynamic=1';
----
1

statement ok
SET dynamic_or_filter_threshold = 100;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(m.id ORDER BY m.id) FROM hms.sample_db.duck_fixture_many_parts m JOIN odd_keys ON m.n = odd_keys.k WHERE m.id < 1000;
----
[1]

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'hive_metastore partitions % table=duck_fixture_many_parts % selected=60 % dynamic=1';
----
1

statement ok
RESET dynamic_or_filter_threshold;

# Several threads read the files of the partitions selected
statement ok
SET threads = 8;

query II
SELECT count(*), count(DISTINCT m.id) FROM hms.sample_db.duck_fixture_many_parts m JOIN (VALUES (1), (250)) t(k) ON m.n = t.k;
----
102	102

statement ok
RESET threads;

# EXPLAIN ANALYZE tells the partitions were selected by the join
query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT p.id FROM hms.sample_db.duck_fixture_pushdown p JOIN int_keys ON p.n = int_keys.k;
----
analyzed_plan	<REGEX>:.*"HMS Partitions": "2 \(cached_plan, dynamic\)".*

# PARTITION_MODE 'path': the join keys skip the files whose key=value directories rule them out, before they are
# opened. sample_db.reviews keeps rating=1 to rating=5 directories.
statement ok
ATTACH 'thrift://localhost:9083' AS hms_path (TYPE hive_metastore, PARTITION_MODE 'path', METADATA_CACHE_TTL 3600);

statement ok
DESCRIBE hms_path.sample_db.reviews;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM hms_path.sample_db.reviews r JOIN (VALUES (5)) t(k) ON r.rating = t.k;
----
30

query II
SELECT count(*) FILTER (WHERE url_decode(request.url) LIKE '%rating=5%') > 0,
       count(*) FILTER (WHERE url_decode(request.url) NOT LIKE '%rating=5%')
FROM duckdb_logs_parsed('HTTP') WHERE request.type = 'GET' AND url_decode(request.url) NOT LIKE '%list-type%';
----
true	0

# DuckDB pushes no join filter into a CSV scan: the rows are right, every partition is read
query I
SELECT list(c.id ORDER BY c.id) FROM hms.sample_db.duck_fixture_spark_csv_parts c JOIN (VALUES ('eu')) t(k) ON c.region = t.k;
----
[1, 2]

# The same rows whenever join filters do not select the partitions
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(p.id ORDER BY p.id) FROM hms_static.sample_db.duck_fixture_pushdown p JOIN int_keys ON p.n = int_keys.k;
----
[2, 6]

statement ok
SET disabled_optimizers = 'join_filter_pushdown';

query I
SELECT list(p.id ORDER BY p.id) FROM hms.sample_db.duck_fixture_pushdown p JOIN int_keys ON p.n = int_keys.k;
----
[2, 6]

statement ok
RESET disabled_optimizers;

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'hive_metastore partitions % dynamic=1';
----
0

query I
SELECT count(*) FROM hms.sample_db.duck_fixture_pushdown p LEFT JOIN int_keys ON p.n = int_keys.k;
----
7

query II
SELECT g.n, g.c FROM (SELECT n, count(*) AS c FROM hms.sample_db.duck_fixture_pushdown GROUP BY n) g JOIN int_keys ON g.n = int_keys.k ORDER BY g.n;
----
2	1
6	1

# A prepared statement selects again on every execution
statement ok
CREATE TEMP TABLE grouped_keys AS SELECT * FROM (VALUES (1, 2), (1, 6), (2, 3)) t(g, k);

statement ok
PREPARE by_group AS SELECT list(p.id ORDER BY p.id) FROM hms.sample_db.duck_fixture_pushdown p JOIN grouped_keys ON p.n = grouped_keys.k WHERE grouped_keys.g = $1;

query I
EXECUTE by_group(1);
----
[2, 6]

query I
EXECUTE by_group(2);
----
[3]

statement ok
CALL disable_logging();
