# name: test/sql/hive/partition_not_fetched_on_listing.test
# description: Listing tables and resolving one never fetches partition lists, one partition at most; only scanning a partitioned table does
# group: [hive]

require hive_metastore

require-env HMS_TEST_AVAILABLE

require httpfs

require parquet

statement ok
CREATE OR REPLACE SECRET s3 (TYPE S3, PROVIDER config, KEY_ID 'minioadmin', SECRET 'minioadmin', ENDPOINT 'localhost:9000', REGION 'us-east-1', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH 'thrift://localhost:9083' AS hms (TYPE hive_metastore, METADATA_CACHE_TTL 3600);

statement ok
CALL enable_logging(level='debug', storage='memory');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) > 0 FROM (SHOW TABLES FROM hms.sample_db);
----
true

query I
SELECT count(*) > 0 FROM pragma_table_info('hms.sample_db.reviews');
----
true

# Listing every table of a schema, and resolving a partitioned one, must not fetch partition lists: a table can have
# hundreds of thousands of partitions. A partitioned Parquet table reads its columns from the files of one partition,
# and asks the metastore for that one only.
query II
SELECT count(*) FILTER (WHERE message LIKE 'hive\_metastore rpc=get\_partition%' ESCAPE '\' AND message NOT LIKE '% max\_parts=1' ESCAPE '\'),
       count(*) FILTER (WHERE message LIKE 'hive\_metastore rpc=get\_partitions db=% max\_parts=1' ESCAPE '\') > 0
FROM duckdb_logs;
----
0	true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM hms.sample_db.reviews;
----
150

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE message LIKE 'hive\_metastore rpc=get\_partition%' ESCAPE '\';
----
true

statement ok
CALL disable_logging();
