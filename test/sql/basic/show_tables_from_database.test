# name: test/sql/basic/show_tables_from_database.test
# description: Test showing tables from a specific database in HMS
# group: [basic]

require hive_metastore

require-env HMS_TEST_AVAILABLE

statement ok
ATTACH 'thrift://localhost:9083' AS hms (TYPE hive_metastore);

# Show available schemas in the HMS
query T
SELECT schema_name FROM information_schema.schemata WHERE catalog_name = 'hms';
----
default
sample_db

# Show all tables in the HMS. Filter out tables created by other tests
# (prefixed with 'duck_') so this test is robust to test ordering.
query T
SELECT table_name FROM information_schema.tables
WHERE table_catalog='hms' AND table_schema='default' AND table_name NOT LIKE 'duck\_%' ESCAPE '\'
ORDER BY table_name;
----

query T
SELECT table_name FROM information_schema.tables
WHERE table_catalog='hms' AND table_schema='sample_db' AND table_name NOT LIKE 'duck\_%' ESCAPE '\'
ORDER BY table_name;
----
customers
decimal_partitioned
inventory
multi_partition
orders
products
reviews
shipments
type_test
