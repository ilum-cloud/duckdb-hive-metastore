# name: test/sql/cache/partition_plan_cache.test
# description: The partition list follows the metadata cache: reused within METADATA_CACHE_TTL, refetched after hms_clear_cache()
# group: [cache]

require hive_metastore

require-env HMS_TEST_AVAILABLE

require httpfs

require parquet

statement ok
CREATE OR REPLACE SECRET s3 (TYPE S3, PROVIDER config, KEY_ID 'minioadmin', SECRET 'minioadmin', ENDPOINT 'localhost:9000', REGION 'us-east-1', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH 'thrift://localhost:9083' AS hms (TYPE hive_metastore, METADATA_CACHE_TTL 3600);

statement ok
CALL enable_logging(level='debug', storage='memory');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM hms.sample_db.reviews;
----
150

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE message LIKE 'hive\_metastore rpc=get\_partition%' ESCAPE '\';
----
true

# Within the TTL the partition list is reused
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM hms.sample_db.reviews WHERE rating = 5;
----
30

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'hive\_metastore rpc=get\_partition%' ESCAPE '\';
----
0

# Clearing the cache makes the next scan fetch the partitions again, so partitions added elsewhere show up
statement ok
CALL hms_clear_cache();

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM hms.sample_db.reviews;
----
150

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE message LIKE 'hive\_metastore rpc=get\_partition%' ESCAPE '\';
----
true

statement ok
CALL disable_logging();
